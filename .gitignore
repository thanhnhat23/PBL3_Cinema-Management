# .gitignore for CinemaManagement (.NET + Next.js)

# Build outputs
server/bin/
server/obj/
server/**/bin/
server/**/obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Logs
*.log

# VS Code settings
.vscode/

# Node modules and logs
client/node_modules/
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*
client/pnpm-debug.log*

# Environment files - only ignore .env (actual values)
.env
client/.env.local

# Don't ignore .env.example
!.env.example

# Next.js
client/.next/
client/out/

# Coverage and test outputs
client/coverage/

# OS generated files
.DS_Store
Thumbs.db

# Ignore package lock files (optional, if you want to commit lock files, remove these)
client/package-lock.json
client/yarn.lock
client/pnpm-lock.yaml

# Ignore migrations build artifacts (not the migration scripts themselves)
server/Migrations/*.Designer.cs

# Ignore publish outputs
server/publish/

# Ignore local secrets
secrets.json

# Ignore ALL appsettings with potential secrets
server/**/appsettings.json
server/**/appsettings.*.json

# EXCEPT example files (templates without secrets)
!server/**/appsettings.example.json

# Ignore backup files
*.bak
*.tmp
~$*

# Ignore ReSharper files
*.ReSharper*
*_ReSharper*/

# Ignore Rider IDE files
.idea/

# Ignore test result files
TestResult*/

# Ignore coverage reports
coverage/

# Ignore NCrunch files
*.ncrunch*
.ncrunch*/

# Ignore Azure Pipeline files
*.azure-pipelines*

# Ignore local database files
*.mdf
*.ldf
*.db
*.sqlite

# Ignore swagger generated files
server/swagger/

# End of .gitignore
server/**/bin/
server/**/obj/
