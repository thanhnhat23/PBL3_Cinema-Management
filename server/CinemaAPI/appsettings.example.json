{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CinemaDatabase": "Server=localhost;Port=3306;Database=CinemaDB;User=root;Password=YOUR_PASSWORD_HERE;",
    "CinemaMongoDB": "mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/CinemaDb"
  },
  "TmdbConfig": {
    "ApiKey": "YOUR_TMDB_API_KEY",
    "BaseUrl": "https://api.themoviedb.org/3/",
    "ImageBaseUrl": "https://image.tmdb.org/t/p/original",
    "YoutubeBaseUrl": "https://www.youtube.com/watch?v=",
    "ConfigEndpoints": {
      "NowPlaying": "movie/now_playing",
      "Upcoming": "movie/upcoming",
      "Popular": "movie/popular",
      "Genres": "genre/movie/list",
      "Credits": "movie/{movie_id}/credits",
      "Videos": "movie/{movie_id}/videos",
      "MovieDetails": "movie/{movie_id}"
    }
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARACTERS",
    "Issuer": "CinemaAPI",
    "Audience": "CinemaClient"
  },
  "Resend": {
    "ApiKey": "YOUR_RESEND_API_KEY"
  },
  "Gemini": {
    "ApiKey": "YOUR_GEMINI_API_KEY",
    "Model": "gemini-2.5-flash"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Vnpay": {
    "vnp_TmnCode": "YOUR_VNPAY_TMN_CODE",
    "vnp_HashSecret": "YOUR_VNPAY_HASH_SECRET",
    "vnp_Url": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "vnp_Api": "https://sandbox.vnpayment.vn/merchant_webapi/api/transaction",
    "vnp_ReturnUrl": "http://localhost:3000/order/vnpay_return",
    "vnp_Version": "2.1.0",
    "vnp_Command": "pay",
    "vnp_CurrCode": "VND",
    "vnp_Locale": "vn"
  }
}
